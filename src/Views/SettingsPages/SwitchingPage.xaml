<UserControl x:Class="WindowsLosslessSwitcher.Views.SettingsPages.SwitchingPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls" xmlns:converters="clr-namespace:WindowsLosslessSwitcher.Converters" xmlns:services="clr-namespace:WindowsLosslessSwitcher.Services">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:EqualityToBoolConverter x:Key="EqualityToBool" />
  </UserControl.Resources>
  <StackPanel>
    <TextBlock FontSize="{StaticResource Nocturne.FontSize.Heading}" FontWeight="Medium" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="[Switching]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </TextBlock.Text>
    </TextBlock>
    <TextBlock Margin="0,16,0,0" FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="[Language]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </TextBlock.Text>
    </TextBlock>
    <ComboBox Margin="0,8,0,0" Width="220" MinHeight="34" Padding="8,5" HorizontalAlignment="Left" Background="#FFF1F2F7" Foreground="#FF222333" ItemsSource="{Binding UiLanguageOptions}" SelectedValue="{Binding UiLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Code" DisplayMemberPath="DisplayName">
      <AutomationProperties.Name>
        <Binding Path="[Language]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </AutomationProperties.Name>
    </ComboBox>
    <TextBlock Margin="0,6,0,0" FontSize="{StaticResource Nocturne.FontSize.Note}" Foreground="{StaticResource Nocturne.Brush.Text45}" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="[Applies immediately. Playback and the Apple Music storefront are unchanged.]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </TextBlock.Text>
    </TextBlock>
    <Control Margin="0,16,0,0" Style="{StaticResource Nocturne.Divider}" />
    <TextBlock Margin="0,16,0,0" Style="{StaticResource Nocturne.Kicker}">
      <controls:Tracking.Text>
        <Binding Path="[DEVICE MODE]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </controls:Tracking.Text>
    </TextBlock>
    <Border Margin="0,8,0,0" HorizontalAlignment="Left" Background="{StaticResource Nocturne.Brush.Recessed}" BorderBrush="{StaticResource Nocturne.Brush.Hover}" BorderThickness="1" CornerRadius="8" Padding="3">
      <StackPanel Orientation="Horizontal">
        <RadioButton GroupName="DeviceMode" IsChecked="{Binding SelectedMode, Converter={StaticResource EqualityToBool}, ConverterParameter=FollowDefault}" Style="{StaticResource Nocturne.SegmentedOption}">
          <RadioButton.Content>
            <Binding Path="[Follow default device]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </RadioButton.Content>
        </RadioButton>
        <RadioButton GroupName="DeviceMode" IsChecked="{Binding SelectedMode, Converter={StaticResource EqualityToBool}, ConverterParameter=PinnedDevice}" Style="{StaticResource Nocturne.SegmentedOption}">
          <RadioButton.Content>
            <Binding Path="[Pin a device]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </RadioButton.Content>
        </RadioButton>
      </StackPanel>
    </Border>
    <StackPanel Margin="0,10,0,0" Visibility="{Binding IsSelectedDeviceSelectionVisible, Converter={StaticResource BoolToVisibility}}">
      <ListBox ItemsSource="{Binding Devices}" SelectedValue="{Binding SelectedDeviceId}" SelectedValuePath="Id" Style="{StaticResource Nocturne.DeviceList}">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal">
              <Grid Width="14" Height="14" VerticalAlignment="Center">
                <Ellipse Width="14" Height="14">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="Transparent" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Nocturne.Brush.AccentTint}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
                <Ellipse Width="8" Height="8">
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Fill" Value="{StaticResource Nocturne.Brush.Ring}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                          <Setter Property="Fill" Value="{StaticResource Nocturne.Brush.Accent}" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </Grid>
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Nocturne.FontSize.Control}" Text="{Binding FriendlyName}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Margin="0,2,0,0" HorizontalAlignment="Left" Command="{Binding RefreshDevicesCommand}" FontSize="{StaticResource Nocturne.FontSize.Secondary}" Padding="10,5" Style="{StaticResource Nocturne.Button.Ghost}">
        <Button.Content>
          <Binding Path="[Refresh devices]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
        </Button.Content>
      </Button>
    </StackPanel>
    <Control Margin="0,20,0,0" Style="{StaticResource Nocturne.Divider}" />
    <StackPanel Margin="0,8,0,0">
      <Grid Margin="0,10,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[Switch bit depth as well as sample rate]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Margin="0,2,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text40}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[When off^, the default bit depth below is always used]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
        <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding SwitchBitDepth}" Style="{StaticResource Nocturne.ToggleSwitch}" />
      </Grid>
      <Grid Margin="0,0,0,10" Visibility="{Binding UseFixedBitDepthSelection, Converter={StaticResource BoolToVisibility}}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="{StaticResource Nocturne.FontSize.Body}" Foreground="{StaticResource Nocturne.Brush.Text70}" TextWrapping="Wrap">
          <TextBlock.Text>
            <Binding Path="[Default bit depth]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </TextBlock.Text>
        </TextBlock>
        <Border Grid.Column="1" Background="{StaticResource Nocturne.Brush.Recessed}" BorderBrush="{StaticResource Nocturne.Brush.Hover}" BorderThickness="1" CornerRadius="8" Padding="3">
          <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="DefaultBitDepth" IsChecked="{Binding DefaultBitDepth, Converter={StaticResource EqualityToBool}, ConverterParameter=16}" Style="{StaticResource Nocturne.SegmentedOption}">
              <RadioButton.Content>
                <Binding Path="[16-bit]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </RadioButton.Content>
            </RadioButton>
            <RadioButton GroupName="DefaultBitDepth" IsChecked="{Binding DefaultBitDepth, Converter={StaticResource EqualityToBool}, ConverterParameter=24}" Style="{StaticResource Nocturne.SegmentedOption}">
              <RadioButton.Content>
                <Binding Path="[24-bit]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </RadioButton.Content>
            </RadioButton>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Margin="0,0,0,14">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[Restart track after sample-rate changes ^(experimental^)]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Margin="0,2,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text40}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[Pauses the song^, mutes the output device during preparation^, then restarts the current track. Allow 10 seconds or more.]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
        <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding RestartTrackAfterSampleRateChange}" AutomationProperties.Name="Restart track after sample-rate changes (experimental)" Style="{StaticResource Nocturne.ToggleSwitch}" />
      </Grid>
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[Prefer closest sample-rate multiple]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
          <TextBlock Margin="0,2,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text40}" TextWrapping="Wrap">
            <TextBlock.Text>
              <Binding Path="[For DACs that stay in the 44.1 / 88.2 / 176.4 family]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </TextBlock.Text>
          </TextBlock>
        </StackPanel>
        <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding PreferClosestSampleRateMultiple}" Style="{StaticResource Nocturne.ToggleSwitch}" />
      </Grid>
      <Grid Margin="0,0,0,10">
        <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
          <TextBlock.Text>
            <Binding Path="[Launch at login]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </TextBlock.Text>
        </TextBlock>
        <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding LaunchAtLogin}" Style="{StaticResource Nocturne.ToggleSwitch}"></ToggleButton>
      </Grid>
    </StackPanel>
    <TextBlock Margin="0,10,0,0" Style="{StaticResource Nocturne.Kicker}">
      <controls:Tracking.Text>
        <Binding Path="[ALLOWED HARDWARE FORMATS]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </controls:Tracking.Text>
    </TextBlock>
    <TextBlock MaxWidth="460" Margin="0,5,0,0" HorizontalAlignment="Left" FontSize="{StaticResource Nocturne.FontSize.Note}" Foreground="{StaticResource Nocturne.Brush.Text45}" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="[Uncheck rates or depths your hardware can't lock to — for chains where a virtual cable or ASIO bridge reports formats the real DAC doesn't support. Checking everything applies no restriction.]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </TextBlock.Text>
    </TextBlock>
    <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding SampleRateOptions}" Visibility="{Binding HasFormatOptions, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ToggleButton Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource Nocturne.Chip.Allowed}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding BitDepthOptions}" Visibility="{Binding HasFormatOptions, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <ToggleButton Margin="0,0,6,6" Content="{Binding Label}" IsChecked="{Binding IsChecked}" Style="{StaticResource Nocturne.Chip.Allowed}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Margin="0,10,0,0" FontSize="{StaticResource Nocturne.FontSize.Note}" Foreground="{StaticResource Nocturne.Brush.Text45}" Visibility="{Binding HasNoFormatOptions, Converter={StaticResource BoolToVisibility}}" TextWrapping="Wrap">
      <TextBlock.Text>
        <Binding Path="[Formats will appear once the target device reports its capabilities.]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </TextBlock.Text>
    </TextBlock>
    <TextBlock Margin="0,6,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text35}" Text="{Binding AllowedFormatsNoteText}" TextWrapping="Wrap" />
    <TextBlock Margin="0,20,0,0" Style="{StaticResource Nocturne.Kicker}">
      <controls:Tracking.Text>
        <Binding Path="[RECOVERY &amp; DIAGNOSTICS]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
      </controls:Tracking.Text>
    </TextBlock>
    <Grid Margin="0,10,0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
          <TextBlock.Text>
            <Binding Path="[Restart Apple Music if playback recovery fails]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Margin="0,2,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text40}" TextWrapping="Wrap">
          <TextBlock.Text>
            <Binding Path="[Last-resort recovery only; the Apple Music play queue may reset]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </TextBlock.Text>
        </TextBlock>
      </StackPanel>
      <ToggleButton Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding RestartAppleMusicOnPlaybackFailure}" Style="{StaticResource Nocturne.ToggleSwitch}"></ToggleButton>
    </Grid>
    <Grid Margin="0,10,0,10">
      <TextBlock VerticalAlignment="Center" FontSize="{StaticResource Nocturne.FontSize.Body}" TextWrapping="Wrap">
        <TextBlock.Text>
          <Binding Path="[Write verbose diagnostics to the log file]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
        </TextBlock.Text>
      </TextBlock>
      <ToggleButton HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding EnableVerboseDiagnostics}" Style="{StaticResource Nocturne.ToggleSwitch}" />
    </Grid>
    <Border Margin="0,14,0,0" Background="{StaticResource Nocturne.Brush.Surface}" BorderBrush="{StaticResource Nocturne.Brush.Ring}" BorderThickness="1" CornerRadius="8" Padding="16,14">
      <StackPanel>
        <TextBlock Style="{StaticResource Nocturne.Kicker}">
          <controls:Tracking.Text>
            <Binding Path="[ORIGINAL FORMAT]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </controls:Tracking.Text>
        </TextBlock>
        <TextBlock Margin="0,5,0,0" FontSize="{StaticResource Nocturne.FontSize.Control}" Foreground="{StaticResource Nocturne.Brush.Text70}" Text="{Binding OriginalFormatText}" TextWrapping="Wrap" />
        <Button Margin="0,10,0,0" HorizontalAlignment="Left" Command="{Binding RestoreOriginalFormatCommand}" FontSize="{StaticResource Nocturne.FontSize.Secondary}" Style="{StaticResource Nocturne.Button.Primary}">
          <Button.Content>
            <Binding Path="[Restore original format]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
          </Button.Content>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>