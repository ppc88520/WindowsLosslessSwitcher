<Window x:Class="WindowsLosslessSwitcher.Views.TrayFlyoutWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:WindowsLosslessSwitcher.Controls" Title="Windows Lossless Switcher" AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource Nocturne.FontFamily}" Foreground="{StaticResource Nocturne.Brush.Text}" ResizeMode="NoResize" ShowActivated="True" ShowInTaskbar="False" SizeToContent="WidthAndHeight" TextOptions.TextFormattingMode="Display" Topmost="True" WindowStartupLocation="Manual" WindowStyle="None" xmlns:services="clr-namespace:WindowsLosslessSwitcher.Services">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>
  <!-- Transparent margin for the popup shadow. -->
  <Border Width="312" Margin="16" Background="{StaticResource Nocturne.Brush.Ground}" BorderBrush="{StaticResource Nocturne.Brush.Ring}" BorderThickness="1" CornerRadius="8" Padding="6" SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" Direction="270" Opacity="0.6" ShadowDepth="8" Color="#FF000000" />
    </Border.Effect>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
        <!-- Now playing row -->
        <Grid Margin="10,9">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Width="42" Height="42" CornerRadius="5">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="{Binding ArtworkGlowColor}" />
                <GradientStop Offset="1" Color="#FF1B1D2B" />
              </LinearGradientBrush>
            </Border.Background>
            <Grid>
              <controls:NocturneIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.White55}" Geometry="{StaticResource Nocturne.Icon.MusicNotes}" />
              <Border CornerRadius="5" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}">
                <Border.Background>
                  <ImageBrush ImageSource="{Binding ArtworkImage}" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
            <controls:MarqueeTextBlock TextElement.FontSize="{StaticResource Nocturne.FontSize.Control}" TextElement.FontWeight="Medium" Text="{Binding TrackTitleText}" />
            <controls:MarqueeTextBlock Margin="0,1,0,0" TextElement.FontSize="{StaticResource Nocturne.FontSize.Small}" TextElement.Foreground="{StaticResource Nocturne.Brush.Text50}" Text="{Binding TrackMetaText}" />
          </StackPanel>
          <Border Grid.Column="2" VerticalAlignment="Center" Background="{StaticResource Nocturne.Brush.AccentTint}" BorderBrush="{StaticResource Nocturne.Brush.AccentDeep}" BorderThickness="1" CornerRadius="6" Padding="8,3">
            <TextBlock FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.AccentLight}" Text="{Binding CurrentDeviceFormatText}" />
          </Border>
        </Grid>
        <!-- Status line -->
        <StackPanel Margin="10,0,10,8" Orientation="Horizontal">
          <Ellipse VerticalAlignment="Center" Style="{StaticResource Nocturne.StatusDot}" />
          <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="{StaticResource Nocturne.FontSize.Note}" Foreground="{StaticResource Nocturne.Brush.Text55}" Text="{Binding PhaseText}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Margin="10,0,10,10">
          <UniformGrid Columns="3">
            <Button Margin="0,0,3,0" MinHeight="34" Padding="8,6" Command="{Binding Playback.PreviousTrackCommand}" Style="{StaticResource Nocturne.Button.Ghost}">
              <Button.Content>
                <Binding Path="[Previous]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.Content>
              <Button.ToolTip>
                <Binding Path="[Previous track]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.ToolTip>
              <AutomationProperties.Name>
                <Binding Path="[Previous track]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </AutomationProperties.Name>
            </Button>
            <Button Margin="2,0" MinHeight="34" Padding="8,6" Command="{Binding Playback.TogglePlaybackCommand}" Content="{Binding Playback.PlayPauseText}" ToolTip="{Binding Playback.PlayPauseText}" AutomationProperties.Name="{Binding Playback.PlayPauseText}" Style="{StaticResource Nocturne.Button.Primary}" />
            <Button Margin="3,0,0,0" MinHeight="34" Padding="8,6" Command="{Binding Playback.NextTrackCommand}" Style="{StaticResource Nocturne.Button.Ghost}">
              <Button.Content>
                <Binding Path="[Next]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.Content>
              <Button.ToolTip>
                <Binding Path="[Next track]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.ToolTip>
              <AutomationProperties.Name>
                <Binding Path="[Next track]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </AutomationProperties.Name>
            </Button>
          </UniformGrid>
          <Button Margin="0,6,0,0" MinHeight="32" Command="{Binding Playback.OpenAppleMusicCommand}" Style="{StaticResource Nocturne.Button.Ghost}">
            <Button.Content>
              <Binding Path="[Open Apple Music]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </Button.Content>
            <AutomationProperties.Name>
              <Binding Path="[Open Apple Music]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
            </AutomationProperties.Name>
          </Button>
          <TextBlock Margin="0,6,0,0" FontSize="{StaticResource Nocturne.FontSize.Small}" Foreground="{StaticResource Nocturne.Brush.Text55}" Text="{Binding Playback.StatusText}" TextWrapping="Wrap" />
        </StackPanel>
        <Control Margin="10,0" Style="{StaticResource Nocturne.Divider.Tray}" />
        <!-- Menu rows -->
        <StackPanel Margin="0,5">
          <Button x:Name="CheckForUpdatesButton" Click="MenuRow_OnClick" Command="{Binding CheckForUpdatesCommand}">
            <Button.Style>
              <Style BasedOn="{StaticResource Nocturne.MenuRow}" TargetType="Button">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasUpdatePrimaryAction}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <StackPanel Orientation="Horizontal">
              <controls:NocturneIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.Text50}" Geometry="{StaticResource Nocturne.Icon.ArrowsClockwise}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Text>
                  <Binding Path="[Check for updates]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Click="MenuRow_OnClick" Command="{Binding RunUpdatePrimaryActionCommand}" Style="{StaticResource Nocturne.MenuRow}" Visibility="{Binding HasUpdatePrimaryAction, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
              <controls:NocturneIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.Text50}" Geometry="{StaticResource Nocturne.Icon.ArrowCircleUp}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="{Binding UpdatePrimaryActionText}" />
            </StackPanel>
          </Button>
          <Button Click="MenuRow_OnClick" Command="{Binding OpenReleasesPageCommand}" Style="{StaticResource Nocturne.MenuRow}">
            <StackPanel Orientation="Horizontal">
              <controls:NocturneIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.Text50}" Geometry="{StaticResource Nocturne.Icon.ArrowSquareOut}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Text>
                  <Binding Path="[Open releases]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Button>
          <Button Click="OpenSettingsRow_OnClick" Style="{StaticResource Nocturne.MenuRow}">
            <StackPanel Orientation="Horizontal">
              <controls:NocturneIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.Text50}" Geometry="{StaticResource Nocturne.Icon.Gear}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Text>
                  <Binding Path="[Open settings]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Button>
          <StackPanel Margin="0,12,0,0">
            <Border Padding="10" CornerRadius="8" BorderBrush="{StaticResource Nocturne.Brush.Ring}" BorderThickness="1" Visibility="{Binding HasRecoveryAdvice, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="{Binding RecoveryTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Margin="0,6,0,0" Text="{Binding RecoveryMessage}" TextWrapping="Wrap" Foreground="{StaticResource Nocturne.Brush.Text75}" />
              </StackPanel>
            </Border>
            <Button Margin="0,8,0,0" Padding="12,8" Command="{Binding RestartToolCommand}" Style="{StaticResource Nocturne.Button.Ghost}">
              <Button.Content>
                <Binding Path="[Restart Tool]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.Content>
            </Button>
            <Button Margin="0,6,0,0" Padding="12,8" Command="{Binding RestartPlayerAndToolCommand}" Style="{StaticResource Nocturne.Button.Ghost}">
              <Button.Content>
                <Binding Path="[Restart Apple Music and Tool]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
              </Button.Content>
            </Button>
          </StackPanel>
          <Button Click="ExitRow_OnClick" Style="{StaticResource Nocturne.MenuRow}">
            <StackPanel Orientation="Horizontal">
              <controls:NocturneIcon Width="15" Height="15" VerticalAlignment="Center" Foreground="{StaticResource Nocturne.Brush.Text50}" Geometry="{StaticResource Nocturne.Icon.SignOut}" />
              <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Text>
                  <Binding Path="[Exit]" Source="{x:Static services:LocalizationService.Current}" Mode="OneWay" />
                </TextBlock.Text>
              </TextBlock>
            </StackPanel>
          </Button>
        </StackPanel>
        <Control Margin="10,0" Style="{StaticResource Nocturne.Divider.Tray}" />
        <TextBlock Margin="10,8" TextWrapping="Wrap" FontSize="{StaticResource Nocturne.FontSize.Faint}" Foreground="{StaticResource Nocturne.Brush.Text35}" ToolTip="{Binding AppVersionText}">
          <Run Text="{Binding AppVersionText, Mode=OneWay}" />
          <Run Text=" · " />
          <Run Text="{Binding UpdateBadgeText, Mode=OneWay}" />
        </TextBlock>
      </StackPanel>
    </ScrollViewer>
  </Border>
</Window>